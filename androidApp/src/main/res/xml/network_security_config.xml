<?xml version="1.0" encoding="utf-8"?>
<!-- Android refuses plain HTTP by default. The demo server runs without TLS on the development machine,
     which the emulator reaches as 10.0.2.2: allow that one address, nothing else. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
